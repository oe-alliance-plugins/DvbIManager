<?xml version="1.0" encoding="UTF-8"?>
<!-- Copy to /etc/enigma2/dvbi.xml to replace these system discovery sources.
     Names, channels, languages and regions are fetched live, not bundled.
     kind: registry (default) or service_list for a direct DVB-I XML URL.
     Default selection is applied only before the user's first selection. -->
<dvbi defaultCountry="DEU" defaultRegion="area-de" defaultSource="germany">
	<source id="global" url="https://query.slrdb.org/providers" />
	<source id="germany" url="https://csr.dvb-i-slr.de/query" target_country="DEU" regulator_only="true" optional="true" />
	<source id="bmt" url="https://dvb-i-germany-slr-staging.bmt-technik.de/query" optional="true" unregulated_test="true" />
	<source id="sofia" url="https://csr.dtv.fi/api/query" optional="true" test_source="true" />
	<source id="freeview-nz" url="https://slr.switch.tv/static/servicelists/dvbi_service_list.xml" kind="service_list" country="NZL" optional="true" test_source="true" />
	<source id="dvb-live" url="https://live-linear.dvb.org/videos/DVB-live-linear/tagdvborg2025dvblivelinear.xml" kind="service_list" optional="true" test_source="true" />
	<source id="dvb-reference" url="https://dvb-i-reference.dvb.org/client/backend/servicelists/example.xml" kind="service_list" optional="true" test_source="true" />
</dvbi>
